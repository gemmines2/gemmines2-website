name: Check products data

on:
  push:
    paths:
      - 'products-data.js'
      - 'images/**'
      - 'videos/**'
  workflow_dispatch:

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Validate products-data.js
        run: node check-products.js
